        "sfx": "templates/storytime-summary/audio/sfx_page_turn.wav",
        "sfxVolume": 0.5,
        "subtitle": "Fue recibido en el austero convento de Saint-Merri, donde el prior lo bautizó oficialmente con el nombre inmortal de Jean-Baptiste.",
        "highlights": [
          "austero",
          "convento",
