      {
        "durationInSeconds": 8.88,
        "image": "templates/storytime-summary/images/scene_13.jpg",
        "animation": "pan-left",
        "audio": "templates/storytime-summary/audio/vo_scene_27.wav",
        "subtitle": "Mientras su madre moría bajo el filo de la guillotina colonial, el niño ya había agotado a tres desesperadas nodrizas en pocas semanas.",
        "highlights": [
          "moría",
          "filo",
          "guillotina",
          "agotado",
          "desesperadas",
          "nodrizas",
          "semanas"
        ],
        "highlightColor": "#FFD700",
        "durationInFrames": 266
      },
      {
        "durationInSeconds": 9.92,
        "image": "templates/storytime-summary/images/scene_5.jpg",
        "animation": "zoom-out",
        "audio": "templates/storytime-summary/audio/vo_scene_28.wav",
        "subtitle": "Ninguna mujer quería cuidarlo más de dos días. Afirmaban con espanto que era voraz y monstruoso, mamando la leche de dos lactantes juntos.",
        "highlights": [
          "ninguna",
          "cuidarlo",
          "espanto",
          "voraz",
          "monstruoso",
          "mamando",
          "leche"
        ],
        "highlightColor": "#E53935",
        "durationInFrames": 298
      },
