        "audio": "templates/storytime-summary/audio/vo_scene_24.wav",
        "sfx": "templates/storytime-summary/audio/sfx_vine_boom.wav",
        "sfxVolume": 0.5,
        "subtitle": "Entonces, de modo imprevisible y sobrenatural, el recién nacido oculto bajo la mesa comenzó a gritar estruendosa y ferozmente.",
        "highlights": [
          "imprevisible",
          "sobrenatural",
          "recién",
          "nacido",
          "gritar",
          "estruendosa",
          "ferozmente"
        ],
        "highlightColor": "#E53935",
        "durationInFrames": 280
      },
      {
        "durationInSeconds": 9.24,
        "image": "templates/storytime-summary/images/scene_12.jpg",
        "animation": "zoom-out",
        "audio": "templates/storytime-summary/audio/vo_scene_25.wav",
        "subtitle": "La gente sorprendida descubrió al bebé entre un repugnante enjambre de moscas, tripas de pescado y barro sucio, salvándole así la vida.",
        "highlights": [
          "sorprendida",
          "descubrió",
          "bebé",
          "repugnante",
          "enjambre",
          "moscas",
          "salvándole"
