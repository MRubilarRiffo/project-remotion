        "animation": "zoom-in",
        "audio": "templates/storytime-summary/audio/vo_scene_30.wav",
        "subtitle": "Pero ante trabas burocráticas y el apremio del tiempo, La Fosse cambió de plan y ordenó entregar al bebé anónimo a una abadía religiosa.",
        "highlights": [
          "trabas",
          "burocráticas",
          "apremio",
          "tiempo",
          "entregar",
          "anónimo",
          "abadía"
        ],
        "highlightColor": "#E53935",
        "durationInFrames": 269
