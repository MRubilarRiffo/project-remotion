        "highlightColor": "#FFD700",
        "durationInFrames": 277
      },
      {
        "durationInSeconds": 9.1,
        "image": "templates/storytime-summary/images/scene_13.jpg",
        "animation": "zoom-in",
        "audio": "templates/storytime-summary/audio/vo_scene_26.wav",
        "sfx": "templates/storytime-summary/audio/sfx_whoosh.wav",
        "sfxVolume": 0.4,
        "subtitle": "Al confesar su madre sin culpa que lo habría dejado morir igual que a los anteriores, fue condenada a muerte y decapitada en la Place de Grève.",
        "highlights": [
          "confesar",
          "culpa",
          "morir",
          "condenada",
          "muerte",
          "decapitada",
          "Grève"
