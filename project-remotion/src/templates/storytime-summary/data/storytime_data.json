        "durationInSeconds": 8.5,
        "image": "templates/storytime-summary/images/scene_5.jpg",
        "animation": "pan-right",
        "audio": "templates/storytime-summary/audio/vo_scene_29.wav",
        "subtitle": "El frustrado oficial de policía La Fosse intentó enviarlo a una inclusa de huérfanos lejana por medio de canastas hacinadas en carretas.",
        "highlights": [
          "frustrado",
          "oficial",
          "policía",
          "inclusa",
          "huérfanos",
          "canastas",
          "carretas"
